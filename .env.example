# Copy to .env and fill in values
DATABASE_URL=postgresql+asyncpg://papertracker:papertracker@postgres/papertracker

# Zotero (get from https://www.zotero.org/settings/keys)
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user   # or "group"
ZOTERO_COLLECTION_KEY=     # optional — if set, sync only this collection (get key from /api/zotero/collections)

# AI providers — at least one required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: local OpenAI-compatible endpoint (e.g. LM Studio)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# Default AI provider: anthropic | openai | local
DEFAULT_AI_PROVIDER=anthropic

# PDF storage (mounted volume in Docker)
PDF_STORAGE_PATH=/data/pdfs

# Zotero sync interval in minutes (0 = disabled)
ZOTERO_SYNC_INTERVAL_MINUTES=300
